{
  "name": "bmad-next-vscode",
  "displayName": "BMAD Next",
  "description": "BMAD control plane inside Code - OSS: missions, ticket tree, evidence, and fail-closed release.",
  "version": "0.1.0",
  "publisher": "bmad-next",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": ["Other", "Testing"],
  "activationEvents": ["onStartupFinished"],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bmad-next/control-plane": "0.1.0"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bmad-next",
          "title": "BMAD Next",
          "icon": "media/bmad.svg"
        }
      ]
    },
    "views": {
      "bmad-next": [
        { "type": "webview", "id": "bmad-next.home", "name": "Mission" }
      ]
    },
    "commands": [
      { "command": "bmad-next.mission", "title": "BMAD: New Mission", "icon": "$(add)" },
      { "command": "bmad-next.history", "title": "BMAD: Mission History", "icon": "$(history)" },
      { "command": "bmad-next.forgeAnswer", "title": "BMAD: Answer Forge Question" },
      { "command": "bmad-next.harden", "title": "BMAD: Harden Forge" },
      { "command": "bmad-next.acceptTickets", "title": "BMAD: Accept Ticket Tree" },
      { "command": "bmad-next.next", "title": "BMAD: What Should I Do Next?" },
      { "command": "bmad-next.release", "title": "BMAD: Run Release Gate" },
      { "command": "bmad-next.doctor", "title": "BMAD Next: Doctor" },
      { "command": "bmad-next.repair", "title": "BMAD: Fix with BMAD" },
      { "command": "bmad-next.refresh", "title": "BMAD: Refresh" },
      { "command": "bmad-next.autopilot", "title": "BMAD: Run Mission Autopilot", "icon": "$(play)" },
      { "command": "bmad-next.stopAutopilot", "title": "BMAD: Stop Autopilot" },
      { "command": "bmad-next.runNextStep", "title": "BMAD: Run Next Workflow Step" },
      { "command": "bmad-next.runSkill", "title": "BMAD: Run Workflow Skill…" },
      { "command": "bmad-next.proposeStories", "title": "BMAD: Propose Stories" },
      { "command": "bmad-next.build", "title": "BMAD: Build Ticket…" },
      { "command": "bmad-next.review", "title": "BMAD: Review Ticket…" },
      { "command": "bmad-next.attack", "title": "BMAD: Attack Ticket…" },
      { "command": "bmad-next.planVerification", "title": "BMAD: Plan Browser and NFR Verification…" },
      { "command": "bmad-next.browser", "title": "BMAD: Run Browser Verification" },
      { "command": "bmad-next.security", "title": "BMAD: Run Security Scan" },
      { "command": "bmad-next.nfr", "title": "BMAD: Measure NFRs" },
      { "command": "bmad-next.verifyArchitecture", "title": "BMAD: Verify Architecture" },
      { "command": "bmad-next.traceability", "title": "BMAD: Verify Traceability" },
      { "command": "bmad-next.requireAllGates", "title": "BMAD: Require All Release Gates" },
      { "command": "bmad-next.jarvis.activate", "title": "BMAD Next: Activate Jarvis Mode", "icon": "$(zap)" },
      { "command": "bmad-next.jarvis.exit", "title": "BMAD Next: Exit Jarvis Mode" },
      { "command": "bmad-next.jarvis.pause", "title": "BMAD Next: Pause Jarvis" },
      { "command": "bmad-next.jarvis.resume", "title": "BMAD Next: Resume Jarvis" },
      { "command": "bmad-next.jarvis.stopSpeaking", "title": "BMAD Next: Stop Jarvis Speaking" },
      { "command": "bmad-next.jarvis.handsFree", "title": "BMAD Next: Toggle Hands-free Conversation" },
      { "command": "bmad-next.jarvis.wakeWord", "title": "BMAD Next: Toggle \"Hey Jarvis\" Listening" },
      { "command": "bmad-next.jarvis.toggle", "title": "BMAD Next: Toggle Jarvis Mode" },
      { "command": "bmad-next.approveRelease", "title": "BMAD: Approve Release…" },
      { "command": "bmad-next.rejectRelease", "title": "BMAD: Reject Release…" }
    ],
    "menus": {
      "view/title": [
        { "command": "bmad-next.history", "when": "view == bmad-next.home", "group": "navigation@1" },
        { "command": "bmad-next.mission", "when": "view == bmad-next.home", "group": "navigation@2" },
        { "command": "bmad-next.autopilot", "when": "view == bmad-next.home", "group": "navigation@3" }
      ]
    },
    "keybindings": [
      { "command": "bmad-next.jarvis.toggle", "key": "ctrl+shift+j", "mac": "cmd+shift+j", "when": "!searchViewletFocus" }
    ],
    "configuration": {
      "title": "BMAD Next",
      "properties": {
        "bmadNext.jarvis.voiceInput": {
          "type": "string",
          "enum": ["local", "gemini", "off"],
          "default": "local",
          "description": "How Jarvis hears and understands. local: whisper.cpp on this machine hears and detects the language, and the mission's Ollama model (BMAD_JARVIS_URL, BMAD_JARVIS_MODEL) answers in the language you spoke. gemini: Gemini with GEMINI_API_KEY. off: typed commands only."
        },
        "bmadNext.jarvis.voiceOutput": {
          "type": "string",
          "enum": ["system", "off"],
          "default": "system",
          "description": "Spoken narration through the system voice (macOS say). Off keeps narration as text."
        },
        "bmadNext.jarvis.narration": {
          "type": "string",
          "enum": ["important", "all", "off"],
          "default": "important",
          "description": "Which real mission events Jarvis narrates: important, warning, error, and completion events; all events; or none."
        },
        "bmadNext.jarvis.autoListen": {
          "type": "string",
          "enum": ["off", "pushToTalk"],
          "default": "pushToTalk",
          "description": "Push-to-talk records only while the talk button (or the Jarvis core) is held. Hands-free conversation and \"Hey Jarvis\" are separate switches in the Jarvis core; while either is on, the microphone stays open and the status bar says so."
        },
        "bmadNext.jarvis.microphoneDevice": {
          "type": "string",
          "default": ":0",
          "description": "AVFoundation audio device for push-to-talk, as ffmpeg names it (for example :0)."
        }
      }
    },
    "chatParticipants": [
      {
        "id": "bmad.next",
        "name": "bmad",
        "description": "BMAD Next control plane",
        "isSticky": true,
        "commands": [
          { "name": "next", "description": "Recommend the next BMAD action" },
          { "name": "doctor", "description": "Check the local BMAD Next environment" },
          { "name": "release", "description": "Run the fail-closed release gate" }
        ]
      }
    ],
    "languageModelTools": [
      { "name": "bmad_get_mission", "displayName": "Get mission", "modelDescription": "Read the active BMAD Next mission summary.", "toolReferenceName": "bmadGetMission", "canBeReferencedInPrompt": true, "inputSchema": { "type": "object", "properties": {} } },
      { "name": "bmad_get_requirement", "displayName": "Get requirement", "modelDescription": "Read one requirement and its proof graph.", "toolReferenceName": "bmadGetRequirement", "canBeReferencedInPrompt": true, "inputSchema": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"] } },
      { "name": "bmad_run_release_gate", "displayName": "Run release gate", "modelDescription": "Evaluate the release gate. Missing evidence is blocked.", "toolReferenceName": "bmadRunReleaseGate", "canBeReferencedInPrompt": true, "inputSchema": { "type": "object", "properties": {} } },
      { "name": "bmad_check_drift", "displayName": "Check drift", "modelDescription": "Cross-check declared architecture and requirements against supplied file text.", "toolReferenceName": "bmadCheckDrift", "canBeReferencedInPrompt": true, "inputSchema": { "type": "object", "properties": {} } },
      { "name": "bmad_get_story", "displayName": "Get story", "modelDescription": "Read one ticket and its plan status.", "toolReferenceName": "bmadGetStory", "canBeReferencedInPrompt": true, "inputSchema": { "type": "object", "properties": { "ref": { "type": "string" } }, "required": ["ref"] } },
      { "name": "bmad_search_memory", "displayName": "Search memory", "modelDescription": "Search project brain entries recorded for the active mission.", "toolReferenceName": "bmadSearchMemory", "canBeReferencedInPrompt": true, "inputSchema": { "type": "object", "properties": { "query": { "type": "string" } }, "required": ["query"] } },
      { "name": "bmad_run_security", "displayName": "Run security", "modelDescription": "Run the configured security scanners against the ticket worktree.", "toolReferenceName": "bmadRunSecurity", "canBeReferencedInPrompt": true, "inputSchema": { "type": "object", "properties": { "ticket": { "type": "string" } } } }
    ]
  }
}
