# Copy to .env and fill values for your machine. Do not commit .env.
# Placeholders only. None of these values are credentials.

# --- Evaluation (make run) -------------------------------------------------------------
# Credential for the model provider. Supply it with `export AI_API_KEY=...`; never commit it.
AI_API_KEY=
# Optional overrides for harness.config.json (the model definition used by make run).
AI_PROVIDER=
AI_MODEL=
AI_BASE_URL=
# Optional: GitHub token for fetching issues past the anonymous rate limit.
GITHUB_TOKEN=

# --- Development runners (bmad-next CLI outside make run) ------------------------------
# Coding runtime id: opencode, openhands, qwen, goose, swe-agent, or mini-swe-agent.
BMAD_RUNTIME=

# Model id passed to the runtime. Example that completed a local OpenCode file write:
# nvidia/openai/gpt-oss-20b
BMAD_MODEL=

# Skill runner executable. Arguments belong in BMAD_RUNNER_ARGS as a JSON array.
# {prompt} is replaced with the skill prompt. The runner's stdout must end with the headless JSON object,
# so use OpenCode's default format; --format json prints the event stream instead. Example:
# BMAD_RUNNER=opencode
# BMAD_RUNNER_ARGS='["run","--pure","--auto","--format","default","--model","nvidia/openai/gpt-oss-20b","{prompt}"]'
BMAD_RUNNER=
BMAD_RUNNER_ARGS=
BMAD_RUNNER_TIMEOUT=180000

# Reviewer. Leave empty to keep review NOT_CONFIGURED.
# The demo configures OpenCode for review when BMAD_RUNTIME=opencode and this is empty.
# Read-only example: OpenCode's plan agent without --auto cannot write files.
# BMAD_REVIEWER_RUNNER=opencode
# BMAD_REVIEWER_ARGS='["run","--pure","--agent","plan","--format","default","--model","nvidia/openai/gpt-oss-20b","{prompt}"]'
BMAD_REVIEWER_RUNNER=
BMAD_REVIEWER_ARGS=
BMAD_REVIEWER_MODEL=
BMAD_REVIEWER_TIMEOUT=180000

# Attacker. It does not fall back to the coding runner. Same read-only shape as the reviewer example.
BMAD_ATTACK_RUNNER=
BMAD_ATTACKER_ARGS=
BMAD_ATTACK_MODEL=
BMAD_ATTACK_TIMEOUT=180000

# Optional providers. Unset means NOT_CONFIGURED.
BMAD_ACP_COMMAND=
BMAD_A2A_URL=
BMAD_LITELLM_URL=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Jarvis voice intent (Gemini). Read only by the VS Code extension host; never sent to a webview.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=20000
